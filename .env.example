# BII LocalFinder Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# Google Calendar OAuth 2.0 Configuration
# ============================================

# Get these from Google Cloud Console:
# https://console.cloud.google.com/
#
# Steps:
# 1. Create a Google Cloud project
# 2. Enable Google Calendar API
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add authorized redirect URIs:
#    - http://localhost/provider/google-calendar-callback.php (dev)
#    - https://yourdomain.com/provider/google-calendar-callback.php (prod)
# 5. Copy Client ID and Secret

GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost/provider/google-calendar-callback.php

# For production, use HTTPS:
# GOOGLE_REDIRECT_URI=https://yourdomain.com/provider/google-calendar-callback.php

# ============================================
# Database Configuration (if needed)
# ============================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bii_localfinder
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ============================================
# Application Settings
# ============================================

APP_NAME=BII LocalFinder
APP_ENV=development
# Change to 'production' when deploying
# APP_ENV=production

APP_DEBUG=true
# Set to false in production
# APP_DEBUG=false

APP_URL=http://localhost
# Change to your domain in production
# APP_URL=https://yourdomain.com

# ============================================
# Session Configuration
# ============================================

SESSION_TIMEOUT=1800
# Session timeout in seconds (30 minutes)

SESSION_PATH=/var/lib/php/sessions
# Make sure this directory is writable

# ============================================
# Security Settings
# ============================================

HTTPS_REQUIRED=false
# Set to true in production to enforce HTTPS
# HTTPS_REQUIRED=true

SECURE_COOKIES=false
# Set to true in production
# SECURE_COOKIES=true

SAMESITE_COOKIES=Lax
# Options: Strict, Lax, None
# Use 'Strict' for maximum security

# ============================================
# API Rate Limiting
# ============================================

# Maximum Google API calls per day (default: 1,000,000)
GOOGLE_API_DAILY_LIMIT=1000000

# Maximum Google API calls per 100 seconds (default: 1,000)
GOOGLE_API_RATE_LIMIT=1000

# ============================================
# Logging Configuration
# ============================================

LOG_CHANNEL=single
# Options: single, daily, slack, syslog

LOG_LEVEL=debug
# Options: debug, info, notice, warning, error, critical, alert, emergency

LOG_PATH=/var/log/bii_localfinder
# Make sure this directory exists and is writable

# ============================================
# Email Configuration (for notifications)
# ============================================

# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=465
# MAIL_USERNAME=your_username
# MAIL_PASSWORD=your_password
# MAIL_FROM_ADDRESS=noreply@yourdomain.com
# MAIL_FROM_NAME=BII LocalFinder

# ============================================
# Cache Configuration
# ============================================

# CACHE_DRIVER=redis
# CACHE_HOST=127.0.0.1
# CACHE_PORT=6379
# CACHE_PASSWORD=null
# CACHE_DB=1

# Token cache timeout (seconds)
TOKEN_CACHE_TTL=300

# ============================================
# Monitoring & Analytics (Optional)
# ============================================

# SENTRY_DSN=your_sentry_dsn_here
# For error tracking and monitoring

# ============================================
# Feature Flags
# ============================================

ENABLE_GOOGLE_CALENDAR=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_TWO_WAY_CALENDAR_SYNC=false
ENABLE_CONFLICT_DETECTION=true

# ============================================
# Notes
# ============================================

# 1. This file should be in the project root directory
# 2. Never commit .env to version control (add to .gitignore)
# 3. Keep credentials secure - use strong, unique secrets
# 4. In production, use secure methods to manage secrets:
#    - Environment variables via hosting platform
#    - Secret management service (AWS Secrets Manager, etc.)
#    - Docker secrets
#    - .env.local for sensitive values (not committed)
#
# 4. To test if env variables are loaded:
#    - Create a test.php file with phpinfo()
#    - Check the $_ENV array

# ============================================
# Quick Start
# ============================================

# 1. Copy this file to .env
#    cp .env.example .env
#
# 2. Fill in your Google OAuth credentials
#
# 3. Run setup script
#    php config/setup-google-calendar.php
#
# 4. Test in browser
#    Log in as provider → Schedule → Integrations → Connect Google Calendar

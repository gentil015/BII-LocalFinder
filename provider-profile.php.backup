        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }
        
        textarea.form-control {
            resize: vertical;
            min-height: 120px;
        }
        
        .featured-badge {
            background: linear-gradient(135deg, var(--warning), #e0a800);
            color: #000;
            padding: 0.3rem 0.8rem;
            border-radius: 15px;
            font-size: 0.7rem;
            font-weight: 600;
            margin-left: 0.5rem;
        }
        
        .verification-level {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            padding: 0.3rem 0.8rem;
            border-radius: 15px;
            font-size: 0.7rem;
            font-weight: 600;
            margin-left: 0.5rem;
        }
        
        .verification-verified {
            background: #d1fae5;
            color: #065f46;
        }
        
        .verification-gold {
            background: #fef3c7;
            color: #92400e;
        }
        
        .verification-premium {
            background: #e0e7ff;
            color: #3730a3;
        }
        
        /* Responsive adjustments */
        @media (max-width: 768px) {
            .profile-header {
                flex-direction: column;
                text-align: center;
                padding: 2rem;
            }
            
            .profile-meta {
                justify-content: center;
            }
            
            .content-grid {
                padding: 1.5rem;
            }
            
            .profile-info {
                min-width: auto;
            }
            
            .services-grid {
                grid-template-columns: 1fr;
            }
        }
        
        .social-links {
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
        }
        
        .social-links a {
            width: 40px;
            height: 40px;
            background: var(--primary);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        
        .social-links a:hover {
            background: #0a58ca;
            transform: translateY(-3px);
        }
        
        .service-highlight {
            border: 2px solid var(--primary);
            background: linear-gradient(135deg, #f8f9fa, #e3f2fd);
        }
        
        .empty-state {
            text-align: center;
            padding: 3rem 2rem;
            color: var(--secondary);
            background: #f8f9fa;
            border-radius: 10px;
        }
        
        .empty-state i {
            font-size: 4rem;
            margin-bottom: 1rem;
            color: #dee2e6;
        }
        
        /* Scheduling Styles */
        .scheduling-section {
            background: #f0f9ff;
            padding: 1.5rem;
            border-radius: 10px;
            margin: 1.5rem 0;
            border: 1px solid #e0f2fe;
        }
        
        .scheduling-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }
        
        .schedule-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin: 1rem 0;
        }
        
        .schedule-item {
            background: white;
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
        }
        
        .schedule-label {
            font-size: 0.8rem;
            color: var(--secondary);
            margin-bottom: 0.5rem;
        }
        
        .schedule-value {
            font-weight: 600;
            color: var(--dark);
        }
        
        .time-slots {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 0.5rem;
        }
        
        .time-slot {
            padding: 0.4rem 0.8rem;
            background: #d1fae5;
            border: 1px solid #a7f3d0;
            border-radius: 4px;
            font-size: 0.8rem;
            color: #065f46;
        }
        
        .time-off-alert {
            background: #fef3c7;
            border: 1px solid #fbbf24;
            border-radius: 6px;
            padding: 0.75rem;
            margin: 0.5rem 0;
            font-size: 0.85rem;
        }
        
        .unavailable-alert {
            background: #fee2e2;
            border: 1px solid #f87171;
            border-radius: 6px;
            padding: 0.75rem;
            margin: 0.5rem 0;
            font-size: 0.85rem;
        }
        
        .availability-note {
            background: #e0f2fe;
            padding: 0.75rem;
            border-radius: 6px;
            margin-top: 1rem;
            font-size: 0.85rem;
            color: #0c4a6e;
        }
        
        /* Calendar widget */
        .calendar-widget {
            background: white;
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            margin: 1rem 0;
        }
        
        .calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }
        
        .calendar-days {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 0.5rem;
            text-align: center;
        }
        
        .calendar-day {
            padding: 0.5rem;
            border-radius: 4px;
            font-size: 0.9rem;
        }
        
        .calendar-day.working {
            background: #d1fae5;
            color: #065f46;
        }
        
        .calendar-day.non-working {
            background: #f1f5f9;
            color: #64748b;
        }
        
        .calendar-day.today {
            background: var(--primary);
            color: white;
            font-weight: bold;
        }
        
        /* Booking validation */
        .booking-validation {
            background: #f8fafc;
            padding: 1rem;
            border-radius: 8px;
            margin: 1rem 0;
            border: 1px solid #e2e8f0;
        }
        
        .validation-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0.5rem 0;
            font-size: 0.9rem;
        }
        
        .validation-item.valid {
            color: var(--success);
        }
        
        .validation-item.invalid {
            color: var(--danger);
        }
        
        /* Negotiation Display Styles */
        .service-negotiable-badge {
            display: inline-block;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-top: 0.5rem;
            white-space: nowrap;
        }
        
        .service-price-range {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .price-fixed {
            color: var(--success);
            font-size: 1.5rem;
        }
        
        .price-range {
            color: var(--primary);
        }
        
        .price-range-label {
            font-size: 0.75rem;
            color: var(--secondary);
            display: block;
            margin-top: 0.25rem;
        }
        
        .offer-button-negotiable {
            background: linear-gradient(135deg, #667eea, #764ba2);
            border: none;
            color: white;
        }
        
        .offer-button-negotiable:hover {
            background: linear-gradient(135deg, #764ba2, #667eea);
            color: white;
        }
    </style>
</head>

                        <?php endif; ?>

                        <?php if (!isLoggedIn()): ?>
                            <p class="text-center text-muted mb-3">
                                Please login to book this service
                            </p>
                            <a href="login.php" class="btn btn-primary w-100">
                                <i class="fas fa-sign-in-alt me-2"></i> Login to Book
                            </a>
                        <?php elseif (isProvider()): ?>
                            <p class="text-center text-muted">
                                Providers cannot book services
                            </p>
                        <?php else: ?>
                            <!-- Availability Validation -->
                            <?php if ($provider['working_hours_start'] && $provider['working_hours_end']): ?>
                                <div class="booking-validation">
                                    <h6 class="mb-2">Availability Check</h6>
                                    <div class="validation-item valid">
                                        <i class="fas fa-check-circle"></i>
                                        <span>Working Hours: <?php echo date('g:i A', strtotime($provider['working_hours_start'])); ?> - <?php echo date('g:i A', strtotime($provider['working_hours_end'])); ?></span>
                                    </div>
                                    <div class="validation-item valid">
                                        <i class="fas fa-check-circle"></i>
                                        <span>Working Days: <?php echo formatWorkingDays($provider['working_days']); ?></span>
                                    </div>
                                    <div class="validation-item valid">
                                        <i class="fas fa-check-circle"></i>
                                        <span>Slot Duration: <?php echo $provider['slot_duration'] ?? 30; ?> minutes</span>
                                    </div>
                                    <?php if (!empty($time_off)): ?>
                                        <div class="validation-item invalid">
                                            <i class="fas fa-exclamation-triangle"></i>
                                            <span>Time Off: <?php echo count($time_off); ?> upcoming period(s)</span>
                                        </div>
                                    <?php endif; ?>
                                </div>
                            <?php endif; ?>

                            <form method="POST" id="bookingForm">
                                <div class="mb-3">
                                    <label class="form-label">Select Service (Optional)</label>
                                    <select name="service_id" class="form-select" id="serviceSelect">
                                        <option value="">Choose a specific service...</option>
                                        <?php foreach ($services as $service): ?>
                                            <option value="<?php echo $service['id']; ?>">
                                                <?php echo htmlspecialchars($service['name']); ?> - RWF <?php echo number_format($service['price'], 0); ?>
                                            </option>
                                        <?php endforeach; ?>
                                    </select>
                                    <div class="form-text">Selecting a specific service helps the provider understand your needs better</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Service Description <span class="text-danger">*</span></label>
                                    <textarea name="service_description" class="form-control" required rows="4" 
                                              placeholder="Describe what you need help with... Be specific about your requirements." id="serviceDescription"></textarea>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Preferred Date <span class="text-danger">*</span></label>
                                        <input type="date" name="preferred_date" class="form-control" required 
                                               min="<?php echo date('Y-m-d'); ?>" 
                                               id="preferredDate"
                                               onchange="validateDate()">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Preferred Time (Optional)</label>
                                        <input type="time" name="preferred_time" class="form-control" 
                                               id="preferredTime"
                                               onchange="validateTime()"
                                               min="<?php echo $provider['working_hours_start'] ?? '08:00'; ?>"
                                               max="<?php echo $provider['working_hours_end'] ?? '17:00'; ?>">
                                    </div>
                                </div>
                                
                                <!-- Date Validation Feedback -->
                                <div id="dateValidation" class="mb-3" style="display: none;"></div>

                                <button type="submit" name="submit_booking" class="btn btn-primary w-100 py-2">
                                    <i class="fas fa-paper-plane me-2"></i> Send Booking Request
                                </button>
                            </form>
                            
                            <div class="availability-note mt-3">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>Note:</strong> The provider's availability is subject to change. You'll receive confirmation within 24 hours.
                            </div>
                        <?php endif; ?>

                        <!-- Contact Info -->
                        <div class="mt-4 pt-4 border-top">
                            <h4 class="h5 mb-3">Contact Information</h4>
                            <div class="d-flex flex-column gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-phone text-primary"></i>
                                    <span><?php echo htmlspecialchars($provider['phone']); ?></span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-envelope text-primary"></i>
                                    <span><?php echo htmlspecialchars($provider['email']); ?></span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-map-marker-alt text-primary"></i>
                                    <span>
                                        <?php echo htmlspecialchars($provider['location']); ?>
                                        <?php if ($provider['district']): ?>, <?php echo htmlspecialchars($provider['district']); ?><?php endif; ?>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Statistics -->
                    <div class="stats-grid mt-3">
                        <div class="stat-box">
                            <div class="number"><?php echo $provider['total_reviews']; ?></div>
                            <div class="label">Total Reviews</div>
                        </div>
                        <div class="stat-box">
                            <div class="number"><?php echo $total_completed_jobs; ?></div>
                            <div class="label">Jobs Completed</div>
                        </div>
                        <div class="stat-box">
                            <div class="number"><?php echo $response_rate; ?>%</div>
                            <div class="label">Response Rate</div>
                        </div>
                        <div class="stat-box">
                            <div class="number"><?php echo count($services); ?></div>
                            <div class="label">Services Offered</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer bg-dark text-white py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="mb-3"><?php echo htmlspecialchars($platform_name); ?></h5>
                    <p class="text-muted mb-0"><?php echo htmlspecialchars($platform_description); ?></p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="text-muted mb-0"><?php echo htmlspecialchars($copyright_text); ?></p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);

        // Function to select a service
        function selectService(serviceId, serviceName) {
            // Update the service select dropdown
            document.getElementById('serviceSelect').value = serviceId;
            
            // Update the service description with the selected service name
            const descriptionTextarea = document.getElementById('serviceDescription');
            const currentText = descriptionTextarea.value.trim();
            const serviceText = `I'm interested in the "${serviceName}" service. `;
            
            if (!currentText.includes(serviceText)) {
                descriptionTextarea.value = serviceText + (currentText ? '\n\n' + currentText : '');
            }
            
            // Highlight the selected service card
            document.querySelectorAll('.service-card').forEach(card => {
                card.classList.remove('service-highlight');
            });
            document.getElementById('service-' + serviceId).classList.add('service-highlight');
            
            // Scroll to the booking form
            document.querySelector('.booking-form').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
            
            // Focus on the description textarea
            descriptionTextarea.focus();
        }

        // Service select change handler
        document.getElementById('serviceSelect').addEventListener('change', function() {
            const serviceId = this.value;
            if (serviceId) {
                // Remove highlights from all cards
                document.querySelectorAll('.service-card').forEach(card => {
                    card.classList.remove('service-highlight');
                });
                
                // Highlight the selected service card
                const selectedCard = document.getElementById('service-' + serviceId);
                if (selectedCard) {
                    selectedCard.classList.add('service-highlight');
                    selectedCard.scrollIntoView({
                        behavior: 'smooth',
                        block: 'center'
                    });
                }
            } else {
                // Remove highlights when no service is selected
                document.querySelectorAll('.service-card').forEach(card => {
                    card.classList.remove('service-highlight');
                });
            }
        });

        // Validate selected date
        function validateDate() {
            const dateInput = document.getElementById('preferredDate');
            const validationDiv = document.getElementById('dateValidation');
            const selectedDate = new Date(dateInput.value);
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            
            // Check if date is in the past
            if (selectedDate < today) {
                validationDiv.innerHTML = `
                    <div class="alert alert-warning p-2 mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Please select a date in the future.
                    </div>
                `;
                validationDiv.style.display = 'block';
                return false;
            }
            
            // Check if it's a working day (basic check - would need server-side validation)
            const dayOfWeek = selectedDate.getDay(); // 0=Sunday, 1=Monday, etc.
            // Convert to our system (1=Monday, 7=Sunday)
            const ourDay = dayOfWeek === 0 ? 7 : dayOfWeek;
            
            // This is a simplified check - actual working days would need to come from the server
            validationDiv.innerHTML = `
                <div class="alert alert-info p-2 mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    Selected: ${selectedDate.toDateString()}. The provider will confirm availability.
                </div>
            `;
            validationDiv.style.display = 'block';
            return true;
        }

        // Validate selected time
        function validateTime() {
            const timeInput = document.getElementById('preferredTime');
            if (!timeInput.value) return;
            
            const selectedTime = timeInput.value;
            const workingStart = '<?php echo $provider['working_hours_start'] ?? "08:00"; ?>';
            const workingEnd = '<?php echo $provider['working_hours_end'] ?? "17:00"; ?>';
            
            if (selectedTime < workingStart || selectedTime > workingEnd) {
                alert(`Selected time is outside working hours (${workingStart} - ${workingEnd})`);
                timeInput.value = '';
            }
        }

        // Enhanced form validation
        document.getElementById('bookingForm')?.addEventListener('submit', function(e) {
            const serviceDescription = document.getElementById('serviceDescription').value.trim();
            const preferredDate = document.querySelector('input[name="preferred_date"]').value;
            
            if (!serviceDescription) {
                e.preventDefault();
                alert('Please provide a service description');
                document.getElementById('serviceDescription').focus();
                return false;
            }
            
            if (!preferredDate) {
                e.preventDefault();
                alert('Please select a preferred date');
                document.querySelector('input[name="preferred_date"]').focus();
                return false;
            }
            
            // Validate date is not in the past
            const selectedDate = new Date(preferredDate);
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            
            if (selectedDate < today) {
                e.preventDefault();
                alert('Please select a date in the future');
                document.querySelector('input[name="preferred_date"]').focus();
                return false;
            }
            
            // Validate time if provided
            const preferredTime = document.querySelector('input[name="preferred_time"]').value;
            if (preferredTime) {
                const workingStart = '<?php echo $provider['working_hours_start'] ?? "08:00"; ?>';
                const workingEnd = '<?php echo $provider['working_hours_end'] ?? "17:00"; ?>';
                
                if (preferredTime < workingStart || preferredTime > workingEnd) {
                    e.preventDefault();
                    alert(`Selected time is outside working hours (${workingStart} - ${workingEnd})`);
                    return false;
                }
            }
            
            // Show confirmation
            return confirm('Are you sure you want to send this booking request?');
        });
        
        // Set minimum date to today
        document.addEventListener('DOMContentLoaded', function() {
            const dateInput = document.getElementById('preferredDate');
            if (dateInput) {
                const today = new Date().toISOString().split('T')[0];
                dateInput.min = today;
                dateInput.value = today;
            }
            
            // Validate initial date
            setTimeout(() => {
                if (dateInput) validateDate();
            }, 100);
        });
        
        // Negotiation Offer Modal
        function openOfferModal(event, btn) {
            event.preventDefault();
            const serviceId = btn.dataset.serviceId;
            const serviceName = btn.dataset.serviceName;
            const minPrice = parseFloat(btn.dataset.minPrice);
            const maxPrice = parseFloat(btn.dataset.maxPrice);
            const basePrice = parseFloat(btn.dataset.basePrice);
            
            // Create modal HTML
            const modalHtml = `
                <div class="modal fade" id="offerModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title">
                                    <i class="fas fa-handshake me-2"></i> Send Price Offer
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Service</label>
                                    <input type="text" class="form-control" value="${serviceName}" disabled>
                                </div>
                                
                                <div class="alert alert-info mb-3">
                                    <strong>Price Range:</strong> RWF ${number_format(minPrice)} - RWF ${number_format(maxPrice)}
                                </div>
                                
                                <form id="offerForm">
                                    <div class="mb-3">
                                        <label for="offerPrice" class="form-label fw-bold">Your Offer Price <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text">RWF</span>
                                            <input type="number" id="offerPrice" class="form-control" min="${minPrice}" max="${maxPrice}" step="100" placeholder="Enter your offer price" required>
                                        </div>
                                        <small class="text-muted d-block mt-2">
                                            Enter a price between RWF ${number_format(minPrice)} and RWF ${number_format(maxPrice)}
                                        </small>
                                        <div id="priceValidation" class="text-danger small mt-2" style="display:none;"></div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label for="offerNote" class="form-label">Additional Message (Optional)</label>
                                        <textarea id="offerNote" class="form-control" rows="3" placeholder="e.g., I need this service by next week, or I'm looking for a bulk discount..."></textarea>
                                    </div>
                                    
                                    <div class="alert alert-light">
                                        <strong>How it works:</strong>
                                        <ul class="mb-0 mt-2" style="font-size: 0.9rem;">
                                            <li>Provider will review your offer within 24 hours</li>
                                            <li>Provider can accept, reject, or counter-offer</li>
                                            <li>Offers expire in 30 minutes</li>
                                            <li>You can make up to 3 offers before finalizing</li>
                                        </ul>
                                    </div>
                                    
                                    <input type="hidden" id="serviceId" value="${serviceId}">
                                </form>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-primary" id="submitOfferBtn">
                                    <i class="fas fa-paper-plane me-2"></i> Send Offer
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            // Remove old modal if exists
            const oldModal = document.getElementById('offerModal');
            if (oldModal) oldModal.remove();
            
            // Add modal to DOM
            document.body.insertAdjacentHTML('beforeend', modalHtml);
            
            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('offerModal'));
            modal.show();
            
            // Price validation
            const priceInput = document.getElementById('offerPrice');
            const validationDiv = document.getElementById('priceValidation');
            
            priceInput.addEventListener('input', function() {
                const price = parseFloat(this.value);
                
                if (!price) {
                    validationDiv.style.display = 'none';
                    return;
                }
                
                if (price < minPrice || price > maxPrice) {
                    validationDiv.textContent = `⚠️ Price must be between RWF ${number_format(minPrice)} and RWF ${number_format(maxPrice)}`;
                    validationDiv.style.display = 'block';
                } else {
                    validationDiv.style.display = 'none';
                }
            });
            
            // Submit offer
            document.getElementById('submitOfferBtn').addEventListener('click', function() {
                const price = parseFloat(priceInput.value);
                const note = document.getElementById('offerNote').value;
                const serviceId = document.getElementById('serviceId').value;
                
                if (!price || price < minPrice || price > maxPrice) {
                    alert('Please enter a valid price within the range');
                    return;
                }
                
                submitOffer(serviceId, price, note);
                modal.hide();
            });
        }
        
        function number_format(num) {
            return new Intl.NumberFormat('en-US').format(num);
        }
        
        function submitOffer(serviceId, offeredPrice, notes = '') {
            // This would normally post to the API
            // For now, show success message
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-success alert-dismissible fade show';
            alertDiv.innerHTML = `
                <i class="fas fa-check-circle me-2"></i>
                <strong>Offer Sent!</strong> The provider will review your offer and respond within 24 hours.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            document.body.insertAdjacentElement('afterbegin', alertDiv);
            
            // Auto-dismiss after 5 seconds
            setTimeout(() => {
                alertDiv.remove();
            }, 5000);
            
            console.log('Offer submitted:', { serviceId, offeredPrice, notes });
        }
    </script>
</body>
</html>
$response_rate_stmt = $db->prepare("
    SELECT COUNT(*) FROM bookings 
    WHERE provider_id = ? AND status IN ('accepted', 'completed', 'rejected')
");
$response_rate_stmt->execute([$provider_id]);
$response_rate = $response_rate_stmt->fetchColumn() ?? 0;

$total_bookings_stmt = $db->prepare("
    SELECT COUNT(*) FROM bookings WHERE provider_id = ?
");
$total_bookings_stmt->execute([$provider_id]);
$total_bookings = $total_bookings_stmt->fetchColumn() ?? 0;

$response_rate = $total_bookings > 0 ? round(($response_rate / $total_bookings) * 100) : 0;

// Calculate average service price
$avg_price_stmt = $db->prepare("
    SELECT AVG(price) FROM provider_services 
    WHERE provider_id = ? AND is_available = 1
");
$avg_price_stmt->execute([$provider_id]);
$avg_service_price = $avg_price_stmt->fetchColumn() ?? 0;

// Format working days
function formatWorkingDays($working_days) {
    if (empty($working_days)) return 'Not set';
    
    $days_map = [
        1 => 'Mon',
        2 => 'Tue',
        3 => 'Wed',
        4 => 'Thu',
        5 => 'Fri',
        6 => 'Sat',
        7 => 'Sun'
    ];
    
    $days_array = explode(',', $working_days);
    $formatted_days = array_map(function($day) use ($days_map) {
        return $days_map[$day] ?? $day;
    }, $days_array);
    
    return implode(', ', $formatted_days);
}

// Generate time slots
function generateTimeSlots($start_time, $end_time, $slot_duration, $break_start = null, $break_end = null) {
    if (empty($start_time) || empty($end_time)) return [];
    
    $slots = [];
    $current = strtotime($start_time);
    $end = strtotime($end_time);
    
    while ($current < $end) {
        $slot_end = strtotime("+{$slot_duration} minutes", $current);
        
        // Skip if in break time
        if ($break_start && $break_end) {
            $break_start_time = strtotime($break_start);
            $break_end_time = strtotime($break_end);
            if (!($slot_end <= $break_start_time || $current >= $break_end_time)) {
                $current = $slot_end;
                continue;
            }
        }
        
        if ($slot_end <= $end) {
            $slots[] = [
                'start' => date('H:i', $current),
                'end' => date('H:i', $slot_end),
                'display' => date('g:i A', $current) . ' - ' . date('g:i A', $slot_end)
            ];
        }
        
        $current = $slot_end;
    }
    
    return $slots;
}
